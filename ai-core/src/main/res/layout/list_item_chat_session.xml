<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/session_row_min_height"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="4dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- One slot, two markers: the tick while browsing, the checkbox while picking several. Fixed
         width and never GONE, so every title starts at the same x and the list does not shuffle
         sideways as the active chat moves or the mode changes. -->
    <FrameLayout
        android:layout_width="@dimen/session_row_icon_size"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/session_active_marker"
            android:layout_width="@dimen/session_row_icon_size"
            android:layout_height="@dimen/session_row_icon_size"
            android:layout_gravity="center"
            android:contentDescription="@string/desc_session_current"
            android:src="@drawable/ic_check"
            android:tint="@color/plugin_primary"
            android:visibility="invisible" />

        <!-- Not clickable itself: the whole row is the target, so a tap anywhere along it ticks
             the chat rather than only a tap on the box. -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/session_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- One line: a title is the user's whole first message, which is often a paragraph. -->
        <TextView
            android:id="@+id/session_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/plugin_on_surface" />

        <TextView
            android:id="@+id/session_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/plugin_text_muted"
            android:textSize="@dimen/chat_caption_text_size" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/session_row_menu"
        android:layout_width="@dimen/session_row_menu_size"
        android:layout_height="@dimen/session_row_menu_size"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/desc_session_row_menu"
        android:padding="@dimen/chat_composer_icon_padding"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_more_vert"
        android:tint="@color/plugin_on_surface_variant" />
</LinearLayout>
