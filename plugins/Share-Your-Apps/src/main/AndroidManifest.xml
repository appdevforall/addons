<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="@string/app_name"
        android:theme="@style/PluginTheme">
        <meta-data android:name="plugin.id" android:value="org.appdevforall.shareyourapps" />
        <meta-data android:name="plugin.name" android:value="Share Your Apps" />
        <meta-data android:name="plugin.version" android:value="${pluginVersion}" />
        <meta-data android:name="plugin.description" android:value="Publish your apps and their source to a store on your local network." />
        <meta-data android:name="plugin.author" android:value="App Dev for All" />
        <meta-data android:name="plugin.min_ide_version" android:value="1.0.0" />
        <!-- network.access: the post-publish check fetches from the server over localhost.
             ide.environment.write: catalog.json lives in the plugin's data directory. -->
        <meta-data android:name="plugin.permissions" android:value="filesystem.read,filesystem.write,network.access,ide.environment.write" />
        <meta-data android:name="plugin.icon_day" android:value="assets/icon_day.png" />
        <meta-data android:name="plugin.icon_night" android:value="assets/icon_night.png" />
        <meta-data android:name="plugin.main_class" android:value="org.appdevforall.shareyourapps.ShareYourAppsPlugin" />
        <meta-data android:name="plugin.sidebar_items" android:value="0" />
    </application>
</manifest>
