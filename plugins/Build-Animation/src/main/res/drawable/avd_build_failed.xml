<?xml version="1.0" encoding="utf-8"?>
<!-- Build failed or was cancelled: a cross draws itself, then shakes once. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <group
                android:name="cross"
                android:pivotX="12"
                android:pivotY="12">
                <path
                    android:name="stroke1"
                    android:pathData="M6,6 L18,18"
                    android:strokeColor="#000000"
                    android:strokeWidth="2.5"
                    android:strokeLineCap="round"
                    android:trimPathEnd="0" />
                <path
                    android:name="stroke2"
                    android:pathData="M18,6 L6,18"
                    android:strokeColor="#000000"
                    android:strokeWidth="2.5"
                    android:strokeLineCap="round"
                    android:trimPathEnd="0" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="stroke1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:duration="200"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="stroke2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:startOffset="200"
                android:duration="200"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="cross">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="translateX"
                android:startOffset="400"
                android:duration="300"
                android:valueFrom="0"
                android:valueTo="1.5"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/cycle" />
        </aapt:attr>
    </target>
</animated-vector>
