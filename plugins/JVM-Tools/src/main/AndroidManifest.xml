<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="JVM Tools"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <meta-data
            android:name="plugin.id"
            android:value="com.appdevforall.jvm.plugin" />

        <meta-data
            android:name="plugin.name"
            android:value="JVM Tools" />

        <meta-data
            android:name="plugin.version"
            android:value="${pluginVersion}" />

        <meta-data
            android:name="plugin.description"
            android:value="Runs Java and Kotlin programs on the device JVM. Open a folder of .java or .kt files, choose the main class and program arguments, and tap Run to compile the project and see its output in Build Output. Adds a Java/Kotlin Program template." />

        <meta-data
            android:name="plugin.author"
            android:value="App Dev For All" />

        <meta-data
            android:name="plugin.min_ide_version"
            android:value="26.37" />

        <meta-data
            android:name="plugin.max_ide_version"
            android:value="26.99" />

        <meta-data
            android:name="plugin.permissions"
            android:value="filesystem.read,filesystem.write,system.commands,project.structure" />

        <meta-data
            android:name="plugin.main_class"
            android:value="com.appdevforall.jvm.plugin.JvmToolsPlugin" />

        <meta-data
            android:name="plugin.icon_day"
            android:value="assets/icon_day.png" />

        <meta-data
            android:name="plugin.icon_night"
            android:value="assets/icon_night.png" />

    </application>

</manifest>
