<?xml version="1.0" encoding="utf-8"?>
<!--
  One HTTP exchange: method and status badges, the URL, then the request and response sections,
  which McpConnectionLogView adds to mcpLogSections. Framework attributes only, as everywhere here.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_mcp_log_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/mcpLogMethod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_mcp_log_badge"
            android:backgroundTint="@color/plugin_primary_container"
            android:fontFamily="monospace"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="@color/plugin_on_primary_container"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mcpLogStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_mcp_log_badge"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/mcpLogUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:textColor="@color/plugin_on_surface"
        android:textIsSelectable="true"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/mcpLogSections"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
