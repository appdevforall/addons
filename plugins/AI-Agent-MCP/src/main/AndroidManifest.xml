<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talks JSON-RPC to MCP servers over HTTPS, or HTTP on this device (McpHttpClient) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="AI Agent MCP Plugin"
        android:theme="@style/PluginTheme">

        <!-- Plugin metadata -->
        <meta-data
            android:name="plugin.id"
            android:value="com.itsaky.androidide.plugins.aiagentmcp" />

        <meta-data
            android:name="plugin.name"
            android:value="AI Agent MCP" />

        <meta-data
            android:name="plugin.version"
            android:value="${pluginVersion}" />

        <!-- Build provenance (ADFA-5256): the commit and commit-date this .cgp was
             built from. Both placeholders are always supplied by the plugin builder. -->
        <meta-data
            android:name="plugin.vcs_revision"
            android:value="${pluginVcsRevision}" />

        <meta-data
            android:name="plugin.build_timestamp"
            android:value="${pluginBuildTimestamp}" />

        <meta-data
            android:name="plugin.description"
            android:value="Connects the Agent to Model Context Protocol servers, so their tools appear alongside the built-in ones. Configure servers under Preferences &gt; Configuration &gt; MCP servers." />

        <meta-data
            android:name="plugin.author"
            android:value="App Dev for All" />

        <!-- 26.47: the first release that knows the debugger.endpoints permission and carries
             DebuggerEndpointService (ADFA-7139); 26.46 and older have neither. Their
             PluginSecurityManager.validatePlugin rejects a manifest that names a permission it
             does not know, so those IDEs cannot install this plugin version at all. Raise this if
             the release that ships ADFA-7139 is not 26.47. 26.43 made plugin-api interface bodies
             Java default methods, which the bundled plugin-api.jar relies on; 26.42 brought
             ServerUrl, which McpUrlPolicy uses to allow http:// only to this device (ADFA-6314);
             26.41 the capability-tag contract (ADFA-6278). Do not lower it. -->
        <meta-data
            android:name="plugin.min_ide_version"
            android:value="26.47" />

        <meta-data
            android:name="plugin.max_ide_version"
            android:value="26.99" />

        <!-- network.access: this plugin only speaks HTTP to the servers the user configured, plus the
             debugger of the open project's app. debugger.endpoints: asks Code on the Go for that
             app's port and token (ADFA-7139). It never touches the filesystem, the project or the
             shell — which is the whole reason MCP lives here instead of inside ai-core. -->
        <meta-data
            android:name="plugin.permissions"
            android:value="network.access,debugger.endpoints" />

        <meta-data
            android:name="plugin.main_class"
            android:value="com.itsaky.androidide.plugins.aiagentmcp.plugin.McpPlugin" />

        <meta-data
            android:name="plugin.icon_day"
            android:value="assets/icon_day.png" />

        <meta-data
            android:name="plugin.icon_night"
            android:value="assets/icon_night.png" />

    </application>

</manifest>
