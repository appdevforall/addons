<?xml version="1.0" encoding="utf-8"?>
<!-- The runs' title, with the button that clears them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/hkRunsTitle"
        style="@style/SectionLabel"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:text="@string/hk_runs_title" />

    <Button
        android:id="@+id/hkClear"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target_min"
        android:text="@string/hk_clear"
        android:textColor="@color/plugin_primary"
        android:textSize="@dimen/text_body" />
</LinearLayout>
