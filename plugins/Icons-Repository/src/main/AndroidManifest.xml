<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="IconsRepository"
        android:theme="@style/PluginTheme"
        tools:ignore="MissingApplicationIcon">

        <!-- Plugin metadata -->
        <meta-data
            android:name="plugin.id"
            android:value="dev.omar.plugin.iconsrepo" />

        <meta-data
            android:name="plugin.name"
            android:value="IconsRepository" />

        <meta-data
            android:name="plugin.icon_day"
            android:value="assets/icon_day.png" />

        <meta-data
            android:name="plugin.icon_night"
            android:value="assets/icon_night.png" />
        <meta-data
            android:name="plugin.version"
            android:value="2.0.3" />

        <meta-data
            android:name="plugin.description"
            android:value="A plugin to help add drawable icons to your Android project on the `CodeOnTheGo` IDE." />

        <meta-data
            android:name="plugin.author"
            android:value="OMAR HAIDAR" />

        <meta-data
            android:name="plugin.min_ide_version"
            android:value="26.42" />

        <!-- Available permissions (comma-separated): - filesystem.read : Read files from the filesystem - filesystem.write : Write files to the filesystem - network.access : Access the network - system.commands : Execute system commands - ide.settings : Access IDE settings - project.structure : Access project structure -->
        <meta-data
            android:name="plugin.permissions"
            android:value="filesystem.read,filesystem.write,project.structure" />

        <meta-data
            android:name="plugin.main_class"
            android:value="dev.omar.plugin.iconsrepo.Main" />

        <meta-data
            android:name="plugin.sidebar_items"
            android:value="1" />

    </application>

</manifest>
