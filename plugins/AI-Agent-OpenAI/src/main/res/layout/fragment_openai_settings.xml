<?xml version="1.0" encoding="utf-8"?>
<!--
  Material fields and buttons throughout, on the shared house spacing scale: QA reported the pane
  did not look like part of Code on the Go, which was the bare framework widgets — unstyled grey
  button slabs and underlined EditTexts. The root android:theme is what guarantees the plugin's
  own button/input styles win over whatever theme the host builds the inflation Context from.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:theme="@style/ThemeOverlay.Plugin">

    <!-- Server -->

    <TextView
        android:id="@+id/openai_server_label"
        style="@style/Plugin.SectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_openai_server" />

    <!-- The preset picker and the model picker are the same control on purpose: one tap opens a
         list, and typing is still possible where it makes sense. -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/openai_preset_box"
        style="@style/PluginTextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_openai_preset"
        app:endIconContentDescription="@string/cd_show_presets"
        app:endIconDrawable="@drawable/ic_dropdown"
        app:endIconMode="custom">

        <AutoCompleteTextView
            android:id="@+id/openai_preset_input"
            style="@style/PluginTextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:completionThreshold="0"
            android:inputType="none"
            android:maxLines="1"
            android:popupBackground="@color/plugin_surface" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/openai_base_url_box"
        style="@style/PluginTextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:hint="@string/hint_openai_server">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/openai_base_url_input"
            style="@style/PluginTextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save_server"
        style="@style/PluginButton.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:text="@string/btn_save_server" />

    <TextView
        android:id="@+id/openai_server_status_text"
        style="@style/Plugin.StatusLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:visibility="gone" />

    <!-- API key. The whole block collapses to openai_key_not_needed_text for a local server. -->

    <TextView
        android:id="@+id/openai_key_not_needed_text"
        style="@style/Plugin.StatusLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:text="@string/msg_key_not_needed"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/openai_key_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:orientation="vertical">

        <TextView
            android:id="@+id/openai_api_key_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:textAppearance="@style/Plugin.Text.Body"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/openai_api_key_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/openai_api_key_label"
                style="@style/Plugin.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_openai_api_key" />

            <!-- The reveal toggle is the box's own end icon rather than a loose ImageButton: it
                 gets a real touch target, and the fragment still owns the click so the window can
                 be flagged secure while the key is legible. Nothing endIcon-related is declared
                 here — SecretRevealController sets the mode, drawable, description and listener in
                 code, because Material 1.10 never reads app:endIconDrawable and the icon a layout
                 asks for draws blank. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/openai_api_key_box"
                style="@style/PluginTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_openai_api_key">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/openai_api_key_input"
                    style="@style/PluginTextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/openai_key_verification_text"
            style="@style/Plugin.StatusLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_api_key"
                style="@style/PluginButton.Filled"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_clear_api_key"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_api_key"
                style="@style/PluginButton.Filled"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:text="@string/btn_edit_api_key"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_api_key"
                style="@style/PluginButton.Filled"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_save_api_key" />

        </LinearLayout>

        <!-- Hidden for a server with no keys to get, where the link means nothing. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_get_key"
            style="@style/PluginButton.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/btn_get_key" />

    </LinearLayout>

    <!-- Model. One editable dropdown: type any name, or pick one the server reported. -->

    <TextView
        android:id="@+id/openai_model_label"
        style="@style/Plugin.SectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:text="@string/label_openai_model" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/openai_model_box"
        style="@style/PluginTextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_openai_model"
        app:endIconContentDescription="@string/cd_show_models"
        app:endIconDrawable="@drawable/ic_dropdown"
        app:endIconMode="custom">

        <AutoCompleteTextView
            android:id="@+id/openai_model_input"
            style="@style/PluginTextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:completionThreshold="0"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:popupBackground="@color/plugin_surface" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/openai_model_hint_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:text="@string/hint_openai_model_help"
        android:textAppearance="@style/Plugin.Text.Small" />

    <!-- Connection test, which is also what fills the model dropdown: both are GET /v1/models. -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_test_connection"
        style="@style/PluginButton.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:text="@string/btn_test_connection" />

    <TextView
        android:id="@+id/openai_connection_status_text"
        style="@style/Plugin.StatusLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:visibility="gone" />

</LinearLayout>
