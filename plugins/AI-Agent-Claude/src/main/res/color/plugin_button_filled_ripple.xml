<?xml version="1.0" encoding="utf-8"?>
<!-- Filled button ripple, drawn in the label colour so it shows on the dark container. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.12" android:color="@color/plugin_on_secondary" android:state_pressed="true" />
    <item android:alpha="0.12" android:color="@color/plugin_on_secondary" android:state_focused="true" />
    <item android:alpha="0.08" android:color="@color/plugin_on_secondary" android:state_hovered="true" />
    <item android:alpha="0.12" android:color="@color/plugin_on_secondary" />
</selector>
