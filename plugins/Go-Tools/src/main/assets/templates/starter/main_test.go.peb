package main

import "testing"

func TestGreet(t *testing.T) {
	cases := []struct {
		in   string
		want string
	}{
		{"Go", "Hello, Go!"},
		{"${{APP_NAME}}", "Hello, ${{APP_NAME}}!"},
	}

	for _, c := range cases {
		if got := greet(c.in); got != c.want {
			t.Errorf("greet(%q) = %q, want %q", c.in, got, c.want)
		}
	}
}
