<?xml version="1.0" encoding="utf-8"?>
<!-- The bubble behind a user message; agent messages sit on the bare surface. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/plugin_surface_variant" />
    <stroke
        android:width="1dp"
        android:color="@color/plugin_outline_variant" />
    <corners android:radius="@dimen/chat_user_bubble_corner_radius" />
</shape>
