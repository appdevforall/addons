    android:shape="rectangle">
    <solid android:color="@color/plugin_surface_variant" />
    <stroke
        android:width="@dimen/chat_user_bubble_editing_stroke_width"
        android:color="@color/plugin_editing" />
    <corners android:radius="@dimen/chat_user_bubble_corner_radius" />
</shape>
