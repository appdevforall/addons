<?xml version="1.0" encoding="utf-8"?>
<!--
  The rounded ripple the sidebar's full-width rows carry. A bare selectableItemBackground squares
  off against the panel edges, which reads as a list row rather than as a button.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/plugin_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/chat_sidebar_action_corner_radius" />
        </shape>
    </item>
</ripple>
