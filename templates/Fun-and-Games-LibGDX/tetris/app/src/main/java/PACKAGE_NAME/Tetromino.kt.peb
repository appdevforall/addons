package ${{PACKAGE_NAME}} 

import com.badlogic.gdx.graphics.Color

enum class TetrominoType(val color: Color) {
    I(Color(0f, 0.9f, 0.9f, 1f)),
    O(Color(0.9f, 0.9f, 0f, 1f)),
    T(Color(0.6f, 0f, 0.9f, 1f)),
    S(Color(0f, 0.8f, 0f, 1f)),
    Z(Color(0.9f, 0f, 0f, 1f)),
    J(Color(0.1f, 0.2f, 0.9f, 1f)),
    L(Color(0.9f, 0.5f, 0f, 1f))
}

// Each rotation state lists the 4 occupied (col, row) cells within a 4x4 bounding box.
val SHAPES: Map<TetrominoType, List<List<IntArray>>> = mapOf(
    TetrominoType.I to listOf(
        listOf(intArrayOf(0, 1), intArrayOf(1, 1), intArrayOf(2, 1), intArrayOf(3, 1)),
        listOf(intArrayOf(2, 0), intArrayOf(2, 1), intArrayOf(2, 2), intArrayOf(2, 3)),
        listOf(intArrayOf(0, 2), intArrayOf(1, 2), intArrayOf(2, 2), intArrayOf(3, 2)),
        listOf(intArrayOf(1, 0), intArrayOf(1, 1), intArrayOf(1, 2), intArrayOf(1, 3))
    ),
    TetrominoType.O to listOf(
        listOf(intArrayOf(1, 0), intArrayOf(2, 0), intArrayOf(1, 1), intArrayOf(2, 1)),
        listOf(intArrayOf(1, 0), intArrayOf(2, 0), intArrayOf(1, 1), intArrayOf(2, 1)),
        listOf(intArrayOf(1, 0), intArrayOf(2, 0), intArrayOf(1, 1), intArrayOf(2, 1)),
        listOf(intArrayOf(1, 0), intArrayOf(2, 0), intArrayOf(1, 1), intArrayOf(2, 1))
    ),
    TetrominoType.T to listOf(
        listOf(intArrayOf(1, 0), intArrayOf(0, 1), intArrayOf(1, 1), intArrayOf(2, 1)),
        listOf(intArrayOf(1, 0), intArrayOf(1, 1), intArrayOf(2, 1), intArrayOf(1, 2)),
        listOf(intArrayOf(0, 1), intArrayOf(1, 1), intArrayOf(2, 1), intArrayOf(1, 2)),
        listOf(intArrayOf(1, 0), intArrayOf(0, 1), intArrayOf(1, 1), intArrayOf(1, 2))
    ),
    TetrominoType.S to listOf(
        listOf(intArrayOf(1, 0), intArrayOf(2, 0), intArrayOf(0, 1), intArrayOf(1, 1)),
        listOf(intArrayOf(1, 0), intArrayOf(1, 1), intArrayOf(2, 1), intArrayOf(2, 2)),
        listOf(intArrayOf(1, 1), intArrayOf(2, 1), intArrayOf(0, 2), intArrayOf(1, 2)),
        listOf(intArrayOf(0, 0), intArrayOf(0, 1), intArrayOf(1, 1), intArrayOf(1, 2))
    ),
    TetrominoType.Z to listOf(
        listOf(intArrayOf(0, 0), intArrayOf(1, 0), intArrayOf(1, 1), intArrayOf(2, 1)),
        listOf(intArrayOf(2, 0), intArrayOf(1, 1), intArrayOf(2, 1), intArrayOf(1, 2)),
        listOf(intArrayOf(0, 1), intArrayOf(1, 1), intArrayOf(1, 2), intArrayOf(2, 2)),
        listOf(intArrayOf(1, 0), intArrayOf(0, 1), intArrayOf(1, 1), intArrayOf(0, 2))
    ),
    TetrominoType.J to listOf(
        listOf(intArrayOf(0, 0), intArrayOf(0, 1), intArrayOf(1, 1), intArrayOf(2, 1)),
        listOf(intArrayOf(1, 0), intArrayOf(2, 0), intArrayOf(1, 1), intArrayOf(1, 2)),
        listOf(intArrayOf(0, 1), intArrayOf(1, 1), intArrayOf(2, 1), intArrayOf(2, 2)),
        listOf(intArrayOf(1, 0), intArrayOf(1, 1), intArrayOf(0, 2), intArrayOf(1, 2))
    ),
    TetrominoType.L to listOf(
        listOf(intArrayOf(2, 0), intArrayOf(0, 1), intArrayOf(1, 1), intArrayOf(2, 1)),
        listOf(intArrayOf(1, 0), intArrayOf(1, 1), intArrayOf(1, 2), intArrayOf(2, 2)),
        listOf(intArrayOf(0, 1), intArrayOf(1, 1), intArrayOf(2, 1), intArrayOf(0, 2)),
        listOf(intArrayOf(0, 0), intArrayOf(1, 0), intArrayOf(1, 1), intArrayOf(1, 2))
    )
)

class Piece(val type: TetrominoType, var rotation: Int = 0, var col: Int = 3, var row: Int = 0) {

    fun cells(rot: Int = rotation): List<IntArray> = SHAPES.getValue(type)[rot.mod(4)]

    fun boardCells(rot: Int = rotation, atCol: Int = col, atRow: Int = row): List<Pair<Int, Int>> =
        cells(rot).map { cell -> Pair(atCol + cell[0], atRow + cell[1]) }
}
