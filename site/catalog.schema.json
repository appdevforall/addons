{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://addons.appdevforall.org/v1/catalog.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "generated",
    "addons"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "generated": {
      "type": "string"
    },
    "addons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/addon"
      }
    }
  },
  "$defs": {
    "addon": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "slug",
        "addonId",
        "name",
        "version",
        "summary",
        "description",
        "origin",
        "license",
        "tags",
        "author",
        "minAppVersion",
        "iconUrl",
        "iconDarkUrl",
        "pageUrl",
        "sourceUrl",
        "download"
      ],
      "properties": {
        "type": {
          "enum": [
            "plugin",
            "template",
            "snippet",
            "code-action"
          ]
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "addonId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)*$"
        },
        "summary": {
          "type": "string",
          "maxLength": 120
        },
        "description": {
          "type": "string"
        },
        "origin": {
          "enum": [
            "appdevforall",
            "community"
          ]
        },
        "license": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "author": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "url"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          }
        },
        "minAppVersion": {
          "type": "string"
        },
        "iconUrl": {
          "type": "string"
        },
        "pageUrl": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string"
        },
        "download": {
          "$ref": "#/$defs/file"
        },
        "sourceTarball": {
          "$ref": "#/$defs/file"
        },
        "iconDarkUrl": {
          "type": "string"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "sha256",
        "size"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$comment": "Additive by design: section 10.5 permits new fields within a major version and requires consumers to ignore unknown ones, so this schema must not reject them. Field removal or retyping needs a new major. Version 2 (ADFA-6252) made two such changes: pluginId became addonId, because the catalog carries four addon types and the name fitted only one; and sourceTarball left the required list, because a template ships none - its .cgt is plain text throughout, so the download already is the source, and sourceUrl still names the directory. A consumer reading a v2 catalog must treat sourceTarball as optional."
}
